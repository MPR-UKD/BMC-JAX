__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# generated sequences and simulation output -- regenerate, never commit
*.seq
*.npz
*.npy
*.h5

# tutorial output
examples/*.png
examples/*.seq

# ...but the phantom measurement tutorials 08 to 11 fit is not generated output. It is the
# input to the fit -- Z-spectra and converted sequences, about 1 MB -- and must ship, or those
# tutorials do not run for anyone who clones this.
!examples/data/*.npz
!examples/data/events/*.npz
!examples/data/seqs/*.seq
# ...and so is the rest of that scan: the sequences as played, the reconstructed images and the
# maps (about 125 MB; every file below GitHub's 50 MB warning size).
!examples/data/scan_2026-09-27/*.npz
!examples/data/scan_2026-09-27/seqs_played/*.seq
!examples/data/scan_2026-09-27/reko/*.npz
